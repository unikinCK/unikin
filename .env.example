# OpenAI-kompatible lokale API (LM Studio) für den nativen Start.
# Im Docker-Container setzt docker-compose.yml die Basis-URL selbst auf
# http://host.docker.internal:1234/v1; läuft LM Studio woanders, LMSTUDIO_URL setzen.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=local-key
# Modell-ID wie von `curl http://localhost:1234/v1/models` bzw. `lms ps` geliefert.
# Bei aktivem Just-in-Time-Laden lädt LM Studio das Modell bei Bedarf.
OPENAI_MODEL=qwen/qwen3.6-35b-a3b
# Timeout pro Modellaufruf in Sekunden; stop_grace_period in docker-compose.yml ist darauf abgestimmt.
OPENAI_TIMEOUT_SECONDS=300
# Höchstens so viele Ausgabe-Tokens pro Anfrage, Denken und Antwort zusammen; 0 = keine Grenze.
# Beendet Denkschleifen weit vor dem Timeout (12000 Tokens ≈ 125 s mit Qwen 3.6 auf dem Mac Studio).
# Schneidet das Budget eine Antwort ab, fragt Unikin einmal ohne Denken nach.
OPENAI_MAX_OUTPUT_TOKENS=12000
#LMSTUDIO_URL=http://host.docker.internal:1234/v1

# Werkzeuge (Python-Runner per MCP). Im Docker-Betrieb setzt docker-compose.yml
# http://runner:8812/mcp; RUNNER_MCP_URL= (leer) schaltet die Werkzeuge ab.
#RUNNER_MCP_URL=
# Höchstens so viele Werkzeugaufrufe pro Zyklus (run_python und search_memory); 0 schaltet die Werkzeuge ab.
MAX_TOOL_CALLS_PER_CYCLE=3
# Langzeitgedächtnis: So viele ältere Journal-Einträge zum aktuellen next_focus stehen als
# related_memory im Prompt (Volltextsuche ohne Modellaufruf); 0 schaltet das ab, höchstens 5.
RELATED_MEMORY_HITS=3

# Vorrang für andere Anwendungen: Nutzt eine andere Anwendung LM Studio, pausiert Unikin bis so viele
# Sekunden nach ihrer letzten Anfrage (erkannt im Serverlog von LM Studio); 0 schaltet das ab.
FOREIGN_REQUEST_COOLDOWN_SECONDS=1200
# Serverlog von LM Studio beim nativen Start. Im Container bindet docker-compose.yml
# ${HOME}/.lmstudio/server-logs ein; ein anderes Verzeichnis auf dem Host über LMSTUDIO_SERVER_LOGS.
#LMSTUDIO_LOG_DIR=~/.lmstudio/server-logs
#LMSTUDIO_SERVER_LOGS=

# Optional: MCP-Server über HTTP mit OAuth, z. B. für LibreChat (siehe docker-compose.mcp-http.yml).
#COMPOSE_FILE=docker-compose.yml:docker-compose.mcp-http.yml
#UNIKIN_MCP_PUBLIC_URL=https://macstudio.tail717550.ts.net:8020
# Konten als name:hash, mehrere durch Komma getrennt; Hash mit: python3 passwords.py
#UNIKIN_OAUTH_USERS=
